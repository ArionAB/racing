# Cross-platform line endings: echipa lucreaza pe Windows, dar scripturile
# ruleaza pe Linux (CI) si Git Bash. CRLF ar rupe `set -euo pipefail`.
* text=auto

*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Godot / binare — nu normaliza.
*.gd    text eol=lf

# Fisiere pe care Godot le rescrie singur la reimport. Fara eol explicit,
# Godot le scrie cu LF, Git le vrea CRLF pe Windows, si raman vesnic
# "modificate" in `git status` cu diff gol — zgomot in fiecare PR.
*.import  text eol=lf
*.uid     text eol=lf
*.tscn    text eol=lf
*.tres    text eol=lf
*.godot   text eol=lf
project.godot text eol=lf
*.png   binary
*.glb   binary
*.fbx   binary
*.blend binary
*.ogg   binary
*.wav   binary
