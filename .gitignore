# Godot 4+
.godot/
snapshots/

# Setari de editor personale (fiecare are alta configuratie).
.vscode/

# Stare locala Claude Code (settings.local.json, worktrees) — per persoana.
.claude/

# Bytecode Python din scripturile de Blender.
__pycache__/
*.pyc

# NU ignoram addons/ intentionat: daca cineva instaleaza un plugin, vrem sa
# vedem asta in `git status`, nu sa dispara in tacere.

# Planse de proba din tools/blender (build_helpers_demo.py). Prefixul `_` le
# tine in afara lotului de assets: nu sunt modele, sunt capturi pentru PR-uri.
assets/models/_*.glb
tools/tmp/
.scratch/

# Plansele si decupajele rundelor de critica: unelte de sesiune, nu sursa.
crop_*.png
sheet_*.png
sheet_*.key

# Capturi de lucru pentru rundele de critica. Se fac cu zecile la fiecare runda
# (o captura = ~1 MB), sunt intermediare prin definitie, si Godot le genereaza
# si cate un .import langa fiecare. In istorie n-au ce cauta: ce ramane dintr-o
# runda e codul si mesajul de commit, nu poza intermediara nr. 7.
r[0-9]*/
z[A-Z]_*.png
zoom_*.png
p[AB].png
[AB]_*.png
stamp_*.png
_*.png

# Capturi de lucru si planse de comparatie. Se fac cu zecile in fiecare runda de
# arta si nu sunt livrabile: gauntlet-ul Cappadocia a lasat 170 de fisiere si
# 37 MB in repo, la o tinta de build sub 100 MB. Capturile care CHIAR conteaza
# stau in docs/ (referinte, crop-uri de brief) sau in assets/.
/zz/
/*.png
/*.png.import
/.??*.png
/.??*.png.import
snapshots/
