#: scenes/race/tutorial/tutorial_config.gd:59
msgid "Hold {drift} while you turn.\nDrifting fills the turbo bar fast!"
msgstr "Maintiens {drift} en tournant.\nDéraper remplit vite la barre de turbo !"

#: scenes/race/tutorial/tutorial_config.gd:60
msgid "Faster! You need speed to drift"
msgstr "Plus vite ! Il faut de la vitesse pour déraper"

#: scenes/race/tutorial/tutorial_config.gd:61
msgid "Now turn while you hold it"
msgstr "Maintenant, tourne sans relâcher"

#: scenes/race/tutorial/tutorial_config.gd:62
msgid "TURBO"
msgstr "TURBO"

#: scenes/race/tutorial/tutorial_config.gd:63
msgid "Hold TURBO (the flame) to burn the bar"
msgstr "Maintiens TURBO (la flamme) pour brûler la barre"

#: scenes/race/tutorial/tutorial_config.gd:64
msgid "Hold {turbo} to burn the bar"
msgstr "Maintiens {turbo} pour brûler la barre"

#: scenes/race/tutorial/tutorial_config.gd:65
msgid "Bar empty: drift to fill it"
msgstr "Barre vide : dérape pour la remplir"

#: scenes/race/tutorial/tutorial_config.gd:66
msgid "YOU'RE READY!"
msgstr "TU ES PRÊT !"

#: scenes/race/tutorial/tutorial_config.gd:67
msgid "Drift fills the bar. TURBO burns it, you pick the moment.\nTIP: hold TURBO as the countdown ends for a ROCKET START."
msgstr "Le dérapage remplit la barre. TURBO la brûle, à toi de choisir le moment.\nASTUCE : maintiens TURBO à la fin du compte à rebours pour un DÉPART CANON."

#: scenes/race/tutorial/tutorial_config.gd:68
#: scenes/ui/tutorial_overlay.gd:110
msgid "SKIP TUTORIAL"
msgstr "PASSER LE TUTORIEL"

#: scenes/race/tutorial/tutorial_config.gd:69
#: scenes/ui/tutorial_overlay.gd:113
msgid "CONTINUE"
msgstr "CONTINUER"

#: scenes/race/tutorial/tutorial_config.gd:72
