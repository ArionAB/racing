#: scenes/race/tutorial/tutorial_config.gd:52
msgid "Hold the LEFT and the RIGHT arrow"
msgstr "Tieni premuta la freccia SINISTRA e quella DESTRA"

#. Keyboard. {steer_left} etc. are replaced with key names: keep them exactly.
#: scenes/race/tutorial/tutorial_config.gd:53
