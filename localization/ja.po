#: scenes/ui/credits_panel.gd:66
msgid "CREDITS"
msgstr "クレジット"

#: scenes/ui/credits_panel.gd:66
msgid "LICENSES & THANKS"
msgstr "ライセンスと謝辞"

#. %s = licence identifier (MIT, OFL-1.1...), never translated.
#: scenes/ui/credits_panel.gd:238
#: scenes/ui/credits_panel.gd:253
msgid "SHOW  %s"
msgstr "表示  %s"

#. %s = licence identifier, never translated.
#: scenes/ui/credits_panel.gd:253
msgid "HIDE  %s"
msgstr "隠す  %s"

#: scenes/ui/loading_screen.gd:269
msgid "TRACK"
msgstr "コース"

#: scenes/ui/loading_screen.gd:58
msgid "Hold TURBO in the last second of the countdown for a rocket start."
msgstr "カウントダウンの最後の1秒でターボを押し続けると、ロケットスタート！"

#: scenes/ui/loading_screen.gd:59
msgid "Drifting fills the turbo bar much faster than driving straight."
msgstr "ドリフトすると、まっすぐ走るよりずっと速くターボゲージがたまる。"

#: scenes/ui/loading_screen.gd:60
msgid "Turbo is yours to spend: save it for a long straight or right before a jump."
msgstr "ターボの使いどころは自分次第。長いストレートやジャンプの直前に取っておこう。"

#: scenes/ui/loading_screen.gd:61
msgid "Heavy cars push, light cars fly. Pick your fights wisely."
msgstr "重い車は押し、軽い車は吹っ飛ぶ。ぶつかる相手はよく選ぼう。"

#: scenes/ui/loading_screen.gd:62
msgid "Grass slows you down, but some shortcuts are still worth the risk."
msgstr "芝生に入ると遅くなるけど、危険をおかす価値のある近道もある。"

#. Position pop-up after an overtake (P3 = 3rd place).
#: scenes/ui/position_popup.gd:61
msgid "P%d"
msgstr "%d位"

#: scenes/race/tutorial/tutorial_config.gd:49
msgid "TUTORIAL"
msgstr "チュートリアル"

#: scenes/race/tutorial/tutorial_config.gd:50
msgid "Follow the hints.\nEach one goes away once you've done it."
msgstr "ヒントに従って操作しよう。\nできたヒントは消えていく。"

#: scenes/race/tutorial/tutorial_config.gd:51
msgid "STEER"
msgstr "ハンドル"

#. Touch screen: the two steering buttons are arrows.
#: scenes/race/tutorial/tutorial_config.gd:52
msgid "Hold the LEFT and the RIGHT arrow"
msgstr "左の矢印と右の矢印を長押ししよう"

#. Keyboard. {steer_left} etc. are replaced with key names: keep them exactly.
#: scenes/race/tutorial/tutorial_config.gd:53
msgid "Hold {steer_left} and {steer_right} to steer"
msgstr "{steer_left}と{steer_right}を長押しでハンドル操作"

#: scenes/race/tutorial/tutorial_config.gd:54
msgid "GAS"
msgstr "アクセル"

#: scenes/race/tutorial/tutorial_config.gd:55
msgid "Hold the green arrow to drive"
msgstr "緑の矢印を長押しで走る"

#: scenes/race/tutorial/tutorial_config.gd:56
msgid "Hold {accelerate} to drive"
msgstr "{accelerate}を長押しで走る"

#: scenes/race/tutorial/tutorial_config.gd:57
msgid "DRIFT"
msgstr "ドリフト"

#: scenes/race/tutorial/tutorial_config.gd:58
msgid "Hold DRIFT while you turn.\nDrifting fills the turbo bar fast!"
msgstr "曲がりながらドリフトボタンを長押し。\nドリフトでターボゲージが一気にたまる！"

#: scenes/race/tutorial/tutorial_config.gd:59
msgid "Hold {drift} while you turn.\nDrifting fills the turbo bar fast!"
msgstr "曲がりながら{drift}を長押し。\nドリフトでターボゲージが一気にたまる！"

#: scenes/race/tutorial/tutorial_config.gd:60
msgid "Faster! You need speed to drift"
msgstr "もっと速く！ドリフトにはスピードが必要"

#: scenes/race/tutorial/tutorial_config.gd:61
msgid "Now turn while you hold it"
msgstr "押したままハンドルを切ろう"

#: scenes/race/tutorial/tutorial_config.gd:62
msgid "TURBO"
msgstr "ターボ"

#: scenes/race/tutorial/tutorial_config.gd:63
msgid "Hold TURBO (the flame) to burn the bar"
msgstr "ターボ（炎のボタン）を長押しでゲージを使う"

#: scenes/race/tutorial/tutorial_config.gd:64
msgid "Hold {turbo} to burn the bar"
msgstr "{turbo}を長押しでゲージを使う"

#: scenes/race/tutorial/tutorial_config.gd:65
msgid "Bar empty: drift to fill it"
msgstr "ゲージが空。ドリフトでためよう"

#: scenes/race/tutorial/tutorial_config.gd:66
msgid "YOU'RE READY!"
msgstr "準備完了！"

#: scenes/race/tutorial/tutorial_config.gd:67
