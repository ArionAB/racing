msgstr "モンスター"

#. Car name (garage card, results).
#: scenes/cars/data/tow_truck.tres:10
msgid "Tow Truck"
msgstr "レッカー車"

#. Driver skin name (the colour of the toy figure).
#: scenes/cars/data/drivers/driver_blue.tres:9
msgid "Blue"
msgstr "ブルー"

#. Driver skin name (the colour of the toy figure).
#: scenes/cars/data/drivers/driver_red.tres:9
msgid "Red"
msgstr "レッド"

#. Driver skin name (the colour of the toy figure).
#: scenes/cars/data/drivers/driver_yellow.tres:9
msgid "Yellow"
msgstr "イエロー"

#. Driver skin name (the colour of the toy figure).
#: scenes/cars/data/drivers/driver_green.tres:9
msgid "Green"
