msgid "%s — RACE %d/%d — %s"
msgstr "%s — レース %d/%d — %s"

#: scenes/race/race.gd:912
msgid "FINAL STANDINGS"
msgstr "最終順位"

#: scenes/race/race.gd:913
msgid "NEXT RACE"
msgstr "次のレース"

#: scenes/race/race.gd:930
msgid "NO TARGET YET"
msgstr "目標タイムなし"

#: scenes/race/race.gd:933
#: scenes/race/race.gd:959
msgid "NO MEDAL"
msgstr "メダルなし"

#. Time — medal reached (GOLD/SILVER/BRONZE/NO MEDAL).
