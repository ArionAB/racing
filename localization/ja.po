#: scenes/ui/career_panel.gd:131
msgid "NEXT CAR  %s  ·  %d MORE POINT"
msgid_plural "NEXT CAR  %s  ·  %d MORE POINTS"
msgstr[0] "次の車  %s  ·  あと%dポイント"

#. Results screen, one line per car just earned in the career.
#: scenes/race/race.gd:922
msgid "NEW CAR: %s"
msgstr "新しい車：%s"

#. Garage SELECT button on a car not earned yet. One line, it must not widen the button.
#: scenes/ui/garage_panel.gd:487
msgid "CAREER: LOCKED"
msgstr "キャリア：ロック中"

#. Garage SELECT button on a locked car: career points still missing. One line.
#: scenes/ui/garage_panel.gd:488
msgid "CAREER: %d MORE PT"
msgid_plural "CAREER: %d MORE PTS"
msgstr[0] "キャリア：あと%d点"

#: scenes/ui/world_cup_panel.gd:31
msgid "CHOOSE A CUP"
msgstr "カップを選ぼう"

#: scenes/ui/world_cup_panel.gd:48
msgid "POINTS PER RACE  6 · 5 · 4 · 3 · 2 · 1"
msgstr "各レースのポイント  6 · 5 · 4 · 3 · 2 · 1"

#. Rule: in one cup no two cars on the grid are the same model.
#: scenes/ui/world_cup_panel.gd:49
msgid "NEW RIVALS EVERY CUP, NEVER THE SAME CAR TWICE"
msgstr "カップごとに新しいライバル、同じ車は二度と出ない"

#: scenes/ui/world_cup_panel.gd:84
msgid "%d RACE"
msgid_plural "%d RACES"
msgstr[0] "%dレース"

#. Button that starts a cup.
#: scenes/ui/world_cup_panel.gd:178
msgid "START"
msgstr "スタート"

#: scenes/ui/track_select_panel.gd:122
msgid "CHOOSE A TRACK"
msgstr "コースを選ぼう"

#. Small caption above a track's best lap time.
#: scenes/ui/track_card.gd:182
msgid "LAP"
msgstr "ラップ"

#: scenes/ui/ai_skill_selector.gd:37
msgid "RIVALS"
msgstr "ライバル"

#: scenes/ui/ai_skill_selector.gd:20
msgid "Relaxed rivals: they brake early and make mistakes."
msgstr "のんびりライバル。早めにブレーキを踏み、ミスもする。"

#: scenes/ui/ai_skill_selector.gd:21
msgid "Solid rivals: clean lines, the occasional slip."
msgstr "手堅いライバル。ライン取りは正確、たまにミスする。"

#: scenes/ui/ai_skill_selector.gd:22
msgid "Flat out: they use every bit of their car."
msgstr "全開。マシンの性能を限界まで引き出す。"

#: scenes/ui/garage_panel.gd:234
#: scenes/ui/garage_panel.gd:481
msgid "SELECT"
msgstr "決定"

#. The toy figure sitting in the car (a skin).
#: scenes/ui/garage_panel.gd:290
msgid "DRIVER"
msgstr "ドライバー"

#: scenes/ui/garage_panel.gd:223
msgid "SPEED"
msgstr "スピード"

#. Acceleration, abbreviated.
#: scenes/ui/garage_panel.gd:223
msgid "ACCEL"
msgstr "加速"

#: scenes/ui/garage_panel.gd:223
msgid "GRIP"
msgstr "グリップ"

#. Car weight: decides who pushes whom.
#: scenes/ui/garage_panel.gd:709
