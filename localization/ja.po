#: scenes/race/race.gd:20
msgid "4th"
msgstr "4位"

#. Finishing position. Only ever used in front of the word for "place" ("FINISH — %s place!", "%s PLACE +%d"); agree with it.
#: scenes/race/race.gd:20
msgid "5th"
msgstr "5位"

#. Finishing position. Only ever used in front of the word for "place" ("FINISH — %s place!", "%s PLACE +%d"); agree with it.
#: scenes/race/race.gd:20
msgid "6th"
msgstr "6位"

#: scenes/race/race.gd:885
msgid "+%d pts  (total %d)"
msgstr "+%d点  （合計 %d点）"

#: scenes/race/race.gd:889
msgid "RECORD!"
msgstr "レコード！"

