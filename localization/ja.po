#: scenes/race/race.gd:293
msgid "EJECTED!"
msgstr "放り出された！"

#: scenes/race/race.gd:302
msgid "STEERING REVERSED  <=>"
msgstr "ハンドル反転  <=>"

#: scenes/race/race.gd:307
msgid "ON FIRE!"
msgstr "炎上中！"

#: scenes/race/race.gd:483
msgid "ROCKET START!"
msgstr "ロケットスタート！"

#: scenes/race/race.gd:486
msgid "Too early..."
msgstr "早すぎた…"

#: scenes/race/race.gd:773
msgid "NEW LAP RECORD! %s"
msgstr "ラップレコード更新！ %s"

#. %s = one of the ordinals 1st..6th below.
#: scenes/race/race.gd:867
#: scenes/race/race.gd:871
msgid "FINISH — %s place!"
msgstr "ゴール — %s！"

#: scenes/race/race.gd:868
msgid "RACE RECORD %s"
msgstr "レースレコード %s"

