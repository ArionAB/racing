msgstr "チャレンジ失敗"

#: scenes/race/race.gd:956
msgid "CHALLENGE +%d"
msgstr "チャレンジ +%d"

#. Countdown, very large text: keep it as short as possible.
#: scenes/race/race.gd:222
msgid "READY?"
msgstr "よーい"

#. Countdown, very large text. Japanese: the classic start call よーい、ドン.
#: scenes/race/race.gd:468
msgid "GO!"
msgstr "ドン！"

#. After the car fell off the track and was put back.
#: scenes/race/race.gd:280
msgid "MISSED — back on track"
msgstr "ミス — コースに復帰"

