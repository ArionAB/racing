msgid "%s — RACE %d/%d — %s"
msgstr "%s — レース %d/%d — %s"

#: scenes/race/race.gd:909
msgid "FINAL STANDINGS"
msgstr "最終順位"

#: scenes/race/race.gd:910
msgid "NEXT RACE"
msgstr "次のレース"

#: scenes/race/race.gd:917
msgid "NO TARGET YET"
msgstr "目標タイムなし"

#: scenes/race/race.gd:920
#: scenes/race/race.gd:946
msgid "NO MEDAL"
msgstr "メダルなし"

#. Time — medal reached (GOLD/SILVER/BRONZE/NO MEDAL).
#: scenes/race/race.gd:921
msgid "TIME TRIAL — %s — %s"
msgstr "タイムアタック — %s — %s"

#: scenes/race/race.gd:922
